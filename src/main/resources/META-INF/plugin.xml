<idea-plugin>
    <id>com.opentech.unused-data-class-property</id>
    <name>Unused Data Class Property</name>
    <vendor>Opentech</vendor>

    <description><![CDATA[
        Highlights primary-constructor components of a Kotlin <code>data class</code>
        that are never read (or, for <code>var</code>, written) anywhere in the project.
        Ignores accesses made by the serializer generated by kotlinx.serialization
        and by custom serializers (<code>KSerializer</code> implementations).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
            language="kotlin"
            shortName="UnusedDataClassProperty"
            displayName="Unused data class property"
            groupName="Kotlin"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.example.unuseddataclass.UnusedDataClassPropertyInspection"/>
    </extensions>
</idea-plugin>
